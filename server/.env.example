# Copiar este archivo como server/.env y llenar los valores reales.
# server/.env NO se sube al repositorio.

API_PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/SIGTI-QA

# Contraseña inicial de los usuarios nuevos creados por el seed (npm run seed).
AUTH_INITIAL_PASSWORD=
# Duración de la sesión en horas (por defecto 8).
SESSION_TTL_HOURS=8
# Opcional: carpeta con los informes de empleados .xlsx (por defecto, seeds/ en la raíz).
# EMPLOYEES_EXCEL_DIR=

# --- Despliegue (opcionales en desarrollo) ---
# Proxies delante de la app: 1 = Nginx. Vacío = no confiar en X-Forwarded-*.
# TRUST_PROXY=
# Fuerza la cookie Secure (true/false). Si no se define: true solo con NODE_ENV=production.
# COOKIE_SECURE=
# Carpeta del frontend compilado para que Express lo sirva (en Docker: /app/client/dist).
# STATIC_DIR=
# Versión desplegada que informa /api/health (en Docker: el commit).
# APP_VERSION=
