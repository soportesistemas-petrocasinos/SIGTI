# Plantilla del archivo de secretos de QA.
# En la VPS: copiar a /opt/sigti-qa/.env, llenar los valores y dejarlo con chmod 600.
# El .env real NUNCA se sube al repositorio ni se comparte por chat.

# Puerto libre de la VPS donde la app escucha (solo en 127.0.0.1). Nginx apunta aquí.
SIGTI_HOST_PORT=

# Base de datos propia de SIGTI QA (contenedor sigti-qa-db-1).
POSTGRES_DB=SIGTI-QA
POSTGRES_USER=sigti
# Solo letras y números (va dentro de una URL). Sugerido: openssl rand -hex 24
POSTGRES_PASSWORD=

# Contraseña inicial de los usuarios que crea el seed (deben cambiarla al entrar).
AUTH_INITIAL_PASSWORD=
SESSION_TTL_HOURS=8

# Opcionales (valores por defecto en docker-compose.yml):
# TRUST_PROXY=1
# COOKIE_SECURE=true
